<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Indie Game Canvas Maker — LamaStudio</title>
<link rel="stylesheet" href="../../style.css">
</head>
<body style="--category-color: var(--c-tech);">
<header class="site-header"><div class="util-row"><a href="index.html" class="brand"><span>← Back to Developer Tools</span></a></div></header>
<main style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
  <h2>🎮 Indie Game Canvas Maker</h2>
  <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Build lightweight HTML5 game loops, sprite templates, and arcade physics.</p>
  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
    <canvas id="gameCanvas" width="400" height="200" style="background:#000; border:1px solid var(--border); border-radius:8px; display:block; margin-bottom:1rem;"></canvas>
    <button onclick="startLoop()" class="portal-btn" style="cursor:pointer; border:none;">Test Game Loop</button>
  </div>
</main>
<script>
let x = 0;
function startLoop() {
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  setInterval(() => {
    ctx.clearRect(0, 0, 400, 200);
    ctx.fillStyle = '#3b82f6';
    ctx.fillRect(x, 80, 40, 40);
    x = (x + 2) % 360;
  }, 1000 / 60);
}
</script>
</body>
</html>
