<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LamaStudio — Education & Online Testing Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../../style.css">
<style>
/* Online Test Hub Custom Styles */
.test-hub-container{max-width:800px;margin:20px auto;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:28px;box-shadow:0 8px 30px rgba(0,0,0,.15)}
.subjects-grid{display:grid;grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));gap:12px;margin:20px 0}
.subject-btn{padding:14px 18px;border:2px solid var(--border);border-radius:12px;background:var(--background);color:var(--text);font-weight:600;font-size:15px;cursor:pointer;transition:.2s;text-align:center}
.subject-btn:hover,.subject-btn.active{border-color:var(--category-color);background:var(--category-color);color:#fff}
.sets-container{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}
.set-btn{padding:10px 20px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font-weight:600;cursor:pointer;transition:.2s}
.set-btn:hover,.set-btn.active{background:var(--category-color);color:#fff;border-color:var(--category-color)}
.quiz-box{margin-top:20px;border-top:1px solid var(--border);padding-top:20px}
.quiz-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;font-weight:bold;color:var(--text-muted)}
.timer{background:#ff4d4d;color:#fff;padding:6px 12px;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:14px}
.question{font-size:19px;font-weight:700;line-height:1.4;margin:15px 0;color:var(--text)}
.option{display:block;width:100%;padding:15px;margin:10px 0;border:2px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text);text-align:left;font-size:16px;cursor:pointer;transition:.2s}
.option:hover:not(:disabled){background:rgba(23,78,166,0.1);border-color:var(--category-color)}
.option.correct{background:#b9f6c5!important;border-color:#159447!important;color:#075b2a!important;font-weight:bold}
.option.wrong{background:#ffb8b8!important;border-color:#d93025!important;color:#8b000
